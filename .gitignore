# Never commit Wine prefixes or Windows installers
*.exe
!scripts/**/*.example
.wine*/
**/drive_c/
system.reg
user.reg
userdef.reg
winetricks.log
.net-fix-evidence/
.env.broker
# Grok local state — keep shared workflows only
.grok/*
!.grok/workflows/
!.grok/workflows/**

# Research market data (regenerate: python3 fetch_data.py)
xauusd_data.csv

# Live broker parity dumps (regenerate; CI uses htf_fib_h1_synthetic)
tests/fixtures/mql5_parity/live_*/

# Multi-instrument packages: future package dirs ignored (already-tracked snapshot stays tracked).
# SHA manifests and schema README stay tracked; bulk CSV trees for new packages stay local-only.
results/instrument_data_packages/*/
results/instrument_data_packages/CURRENT
!results/instrument_data_packages/README.md
!results/instrument_data_packages/*.sha256.json
results/instrument_data
results/instrument_data_manifests
results/multi_instrument_data_readiness.md
results/multi_instrument_data_readiness.FAIL.md
