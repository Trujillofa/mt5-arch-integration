{
  "id": "c6_round_trip_costs",
  "clause": "C6",
  "cases": [
    {
      "engine": "xau_backtest_simulate",
      "inputs": {
        "spread_pts": 20.0,
        "slippage_points": 5.0,
        "point_size": 0.01,
        "contract_size": 100.0,
        "lots": 0.10,
        "commission_per_lot": 0.0
      },
      "expected_cost_usd": 3.0,
      "derivation": "RT pts = spread + 2*slip = 20 + 10 = 30. Dollars = 30 * point_size * CONTRACT_SIZE * lots + 2*comm*lots = 30 * 0.01 * 100 * 0.10 + 0 = 30 * 0.1 = 3.00."
    },
    {
      "engine": "eurusd_ny_scalp",
      "inputs": {
        "spread_pts": 12.0,
        "slippage_points": 5.0,
        "point_size": 1e-5,
        "contract_size": 100000.0,
        "lots": 0.18,
        "commission_per_lot": 0.0
      },
      "expected_cost_usd": 3.96,
      "derivation": "RT pts = 12 + 2*5 = 22. Dollars = 22 * 1e-5 * 100000 * 0.18 = 22 * 1.0 * 0.18 = 3.96."
    },
    {
      "engine": "us_index_session_backtest",
      "inputs": {
        "spread_pts": 60.0,
        "slippage_points": 10.0,
        "point_size": 0.01,
        "contract_size": 1.0,
        "lots": 1.0,
        "commission_per_lot": 0.0
      },
      "expected_cost_usd": 0.80,
      "derivation": "Frozen book: lots=1, slip=10/side. RT pts = 60 + 20 = 80. Dollars = 80 * 0.01 * 1 * 1 = 0.80."
    }
  ]
}
