# Copy to .env and fill in real values. Never commit .env.

# -----------------------------------------------------------------------------
# MT5 account (broker terminal login)
# -----------------------------------------------------------------------------
MT5_LOGIN=118248
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=WSFmarkets-Server

# Optional: path to terminal64.exe if auto-detect fails
# MT5_TERMINAL_PATH=

# -----------------------------------------------------------------------------
# RPyC bridge (mt5server under Wine)
# -----------------------------------------------------------------------------
MT5_RPYC_HOST=localhost
MT5_RPYC_PORT=18812

# -----------------------------------------------------------------------------
# Wine prefix used by install/start scripts
# -----------------------------------------------------------------------------
WINEPREFIX=/home/yderf/.mt5
WINEARCH=win64

# Optional: local path to mt5setup.exe (defaults to common download locations)
# MT5_SETUP=/home/yderf/storage/Downloads/mt5setup.exe

# Set to 1 to run live smoke tests (requires terminal + mt5server)
# MT5_LIVE_SMOKE=0
