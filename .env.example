# Copy to .env and fill in real values. Never commit .env.

# -----------------------------------------------------------------------------
# Backend: file (recommended on Wine) | rpyc (mt5linux — often IPC-timeouts)
# -----------------------------------------------------------------------------
MT5_BACKEND=file

# -----------------------------------------------------------------------------
# MT5 account (broker terminal login)
# Multi-broker: config/brokers/{wsf,vantage,fpmarkets}.env + scripts/16-use-broker.sh
# Placeholders like your_mt5_password_here will be rejected by force-login.
# -----------------------------------------------------------------------------
MT5_LOGIN=149736
MT5_PASSWORD=
MT5_SERVER=WSFmarkets-Server
# Other live examples:
#   Vantage:    MT5_LOGIN=27496181 MT5_SERVER=VantageMarkets-Live 5 WINEPREFIX=~/.mt5-vantage
#   FP Markets: MT5_LOGIN=84076984 MT5_SERVER=FPMarketsSC-Live    WINEPREFIX=~/.mt5-fpmarkets

# Windows path inside Wine for RPyC initialize (not a Linux path)
# Prefer unset when using multiple prefixes — scripts find terminal under WINEPREFIX
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# -----------------------------------------------------------------------------
# File bridge (Mt5ArchBridge.mq5) — used when MT5_BACKEND=file
# -----------------------------------------------------------------------------
# MT5_BRIDGE_DIR=~/.mt5-wsf/drive_c/Program Files/MetaTrader 5/MQL5/Files/mt5_arch
# Wine timer jitter: 15–60s is reasonable; status warns above 60s
MT5_BRIDGE_MAX_AGE=60


# -----------------------------------------------------------------------------
# RPyC bridge (mt5server under Wine) — used when MT5_BACKEND=rpyc
# -----------------------------------------------------------------------------
MT5_RPYC_HOST=localhost
MT5_RPYC_PORT=18812

# -----------------------------------------------------------------------------
# Wine prefix used by install/start scripts
#   ~/.mt5-wsf      — WSFmarkets MT5 Terminal
#   ~/.mt5-vantage  — Vantage International MT5
#   ~/.mt5-fpmarkets — FP Markets MT5 Terminal
#   ~/.mt5          — legacy generic MetaQuotes portable
# -----------------------------------------------------------------------------
WINEPREFIX=/home/yderf/.mt5-wsf
WINEARCH=win64

# Optional: local path to mt5setup.exe (defaults to common download locations)
# MT5_SETUP=/home/yderf/storage/Downloads/mt5setup.exe
# Broker builds:
#   wsfmarkets5setup.exe | vantageinternational5setup.exe | fpmarketssc5setup.exe
#   /home/yderf/storage/Downloads/wsfmarkets5setup.exe
#   /home/yderf/storage/Downloads/vantageinternational5setup.exe

# Set to 1 to run live smoke tests
# MT5_LIVE_SMOKE=0
