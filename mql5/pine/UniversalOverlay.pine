// UniversalOverlay.pine
// One-chart attach for the five in-repo overlay families.
// Standalone files stay the source-faithful per-family ports.
//
// Observe-only. promote=no. merge ≠ deploy. Not a live host.
// Never strategy / never orders. Not a live signal.
//
// Families (SignalContract.mqh):
//   FX HTF Fib          mql5/Indicators/ForexHtfPivotsFib.mq5        buffer 8
//   FX template         mql5/Indicators/ForexIndicatorTemplate.mq5   buffer 9 (8 = short arrow)
//   US index scalp      mql5/Indicators/UsIndexSessionScalp.mq5      buffer 8
//   BTC H1 pullback     mql5/Indicators/BtcTrendPullback.mq5         buffer 7
//   BTC NY scalp        mql5/Indicators/BtcNySessionScalp.mq5        buffer 8  SCREEN_FAIL
//
// GoldSessionScalp / OilSessionScalp are host-only — not invented, not included.
//
// Compute: only the selected family's signal/VWAP/swing/ORB state runs each bar.
// request.security is always registered (Pine limitation); unused families
// request the chart TF and a `na` expression (not H4/D1/H1 books, not pivots).
// Session clocks are cheap IANA reads at global scope so `[1]` day-keys work
// (declaring etKey inside `if isUIS` makes etKey[1] na → VWAP resets every bar).

//@version=5
indicator("Universal Overlay (observe-only)", shorttitle="UNIV", overlay=true, max_labels_count=50, max_lines_count=50, max_boxes_count=20)

TZ_NY = "America/New_York"
TZ_LON = "Europe/London"
TZ_TYO = "Asia/Tokyo"

// === Overlay family ===
string InpOverlay = input.string("FX HTF Fib (ForexHtfPivotsFib)", "Overlay family", options=["FX HTF Fib (ForexHtfPivotsFib)", "FX template (ForexIndicatorTemplate)", "US index scalp (UsIndexSessionScalp)", "BTC H1 pullback (BtcTrendPullback)", "BTC NY scalp (BtcNySessionScalp)"], group="=== Overlay family ===", tooltip="Computes only this family. Other groups apply only when that family is selected. BTC NY scalp is SCREEN_FAIL / promote=no.")
bool InpShowPanel = input.bool(true, "InpShowPanel", group="=== Overlay family ===")
bool InpShowMarkers = input.bool(true, "InpShowMarkers", group="=== Overlay family ===")
bool InpShowEmas = input.bool(true, "InpShowEmas", group="=== Overlay family ===")

bool isHTF = InpOverlay == "FX HTF Fib (ForexHtfPivotsFib)"
bool isFXIT = InpOverlay == "FX template (ForexIndicatorTemplate)"
bool isUIS = InpOverlay == "US index scalp (UsIndexSessionScalp)"
bool isBTP = InpOverlay == "BTC H1 pullback (BtcTrendPullback)"
bool isBNS = InpOverlay == "BTC NY scalp (BtcNySessionScalp)"
// SignalContract.mqh: HTFFIB=8 UIS=8 BNS=8 BTP=7 FXIT=9
int sigBuf = isHTF ? 8 : isFXIT ? 9 : isUIS ? 8 : isBTP ? 7 : isBNS ? 8 : -1
string famCode = isHTF ? "HTFFIB" : isFXIT ? "FXIT" : isUIS ? "UIS" : isBTP ? "BTP" : isBNS ? "BNS" : "?"

