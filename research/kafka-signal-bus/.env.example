# RESEARCH-ONLY placeholders. Copy to .env (gitignored). Never commit secrets.
# Do not point this at funded Wine prefixes or Seven Desk hosts.

# Host-side clients (Python stub, console tools)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=mt5.signals.paper.v1
KAFKA_CLIENT_ID=mt5-arch-research-stub
KAFKA_GROUP_ID=mt5-arch-research-logger

# Must stay 0 unless an operator explicitly opts into a local broker.
# uv sync does not install a Kafka client library.
KAFKA_ENABLE=0

# Optional UI (docker compose --profile ui)
KAFKA_UI_PORT=8080
