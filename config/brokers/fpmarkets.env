# FP Markets SC — source this (or use scripts/16-use-broker.sh fpmarkets)
# Set MT5_LOGIN / MT5_SERVER after GUI login (Journal shows exact server name).
export WINEPREFIX="${HOME}/.mt5-fpmarkets"
export WINEARCH=win64
export MT5_BACKEND=file
# Update after GUI login from Journal (exact server name):
export MT5_LOGIN=0
export MT5_SERVER="FPMarkets-Server"
# MT5_PASSWORD=   # set in shell when using --login
export MT5_BRIDGE_MAX_AGE=60
unset MT5_TERMINAL_PATH
