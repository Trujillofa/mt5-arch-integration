# Fortraders / FT Trading — source this (or use scripts/16-use-broker.sh fortraders)
# Password stays in gitignored repo .env as FORTRADERS_MT5_PASSWORD.
# Firm id is fortraders — not ft, not FTMO, not FP Markets, not FundingPips.
export WINEPREFIX="${HOME}/.mt5-fortraders"
export WINEARCH=win64
export MT5_BACKEND=file
export MT5_LOGIN=737150
export MT5_SERVER=FTTrading-Server
export MT5_BROKER=fortraders
export MT5_BRIDGE_MAX_AGE=60
unset MT5_TERMINAL_PATH
