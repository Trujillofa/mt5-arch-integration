# WSF Markets — source this (or use scripts/16-use-broker.sh wsf)
# Put the REAL master password for login 149736 below (GUI login already works).
export WINEPREFIX="${HOME}/.mt5-wsf"
export WINEARCH=win64
export MT5_BACKEND=file
export MT5_LOGIN=149736
export MT5_SERVER=WSFmarkets-Server
# MT5_PASSWORD=   # set in shell or copy into .env when using this broker
export MT5_BRIDGE_MAX_AGE=60
unset MT5_TERMINAL_PATH
