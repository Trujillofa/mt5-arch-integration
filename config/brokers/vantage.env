# Vantage International — source this (or use scripts/16-use-broker.sh vantage)
# Put the REAL master password for login 27496181 below.
export WINEPREFIX="${HOME}/.mt5-vantage"
export WINEARCH=win64
export MT5_BACKEND=file
export MT5_LOGIN=27496181
# Exact server name from live Journal (not VantageInternational-Live 5)
export MT5_SERVER="VantageMarkets-Live 5"
# MT5_PASSWORD=   # set in shell or .env when using this broker
export MT5_BRIDGE_MAX_AGE=60
unset MT5_TERMINAL_PATH
