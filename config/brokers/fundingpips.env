# FundingPips — source this (or use scripts/16-use-broker.sh fundingpips)
# Password stays in gitignored repo .env as FUNDINGPIPS_MT5_PASSWORD.
# Not FP Markets (fpmarkets / ~/.mt5-fpmarkets).
export WINEPREFIX="${HOME}/.mt5-fundingpips"
export WINEARCH=win64
export MT5_BACKEND=file
export MT5_LOGIN=11669306
export MT5_SERVER=FundingPips2-SIM
export MT5_BROKER=fundingpips
export MT5_BRIDGE_MAX_AGE=60
unset MT5_TERMINAL_PATH
