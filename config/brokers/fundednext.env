# FundedNext — source this (or use scripts/16-use-broker.sh fundednext)
# Password stays in gitignored repo .env as FUNDEDNEXT_MT5_PASSWORD.
export WINEPREFIX="${HOME}/.mt5-fundednext"
export WINEARCH=win64
export MT5_BACKEND=file
export MT5_LOGIN=13981906
export MT5_SERVER="FundedNext-Server 2"
